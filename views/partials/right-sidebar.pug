aside.right-sidebar
  div.sidebar-tags
    span.sidebar-header Trending
    .tag-filters 
      button.tag-filter-btn(data-tag="#dawgpack") #dawgpack
  div.sidebar-tags
    span.sidebar-header Suggested Topics
    div.tag-filters
      button.tag-filter-btn(data-tag="ai") AI
      button.tag-filter-btn(data-tag="huskyfootball") Husky Football
      button.tag-filter-btn(data-tag=user.major)= user.major
  div.sidebar-tags
    span.sidebar-header Suggested Courses
    div.tag-filters
      for course in suggestedCourses
        a.tag-filter-btn(href=`/courses/${course._id}`)= course.courseCode
      a.btn.tag-filter-btn(href="/courses/") Browse more courses