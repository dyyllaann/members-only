extends layout

block content
  if user
    block appBar
      include partials/app-bar.pug
    div.app-shell#feed-content
      aside.left-sidebar
        div.sidebar-links
          div.nav-btn(class=currentPath === "/" ? "active" : "")
            a.sidebar-link(href="/" aria-current=currentPath === "/" ? "page" : undefined)
              img.nav-icon(src="/resources/home.svg" alt="")
              span Home
          div.nav-btn(class=currentPath === "/explore" ? "active" : "")
            a.sidebar-link(href="/explore" aria-current=currentPath === "/explore" ? "page" : undefined)
              img.nav-icon(src="/resources/explore.svg" alt="")
              span Explore
          div.nav-btn.btn-inactive(class=currentPath === "/notifications" ? "active" : "")
            a.sidebar-link(href="/notifications" aria-current=currentPath === "/notifications" ? "page" : undefined)
              img.nav-icon(src="/resources/notifications.svg" alt="")
              span Notifications
          div.nav-btn(class=currentPath.startsWith("/profile/") ? "active" : "")
            a.sidebar-link(href=`/profile/${user.username}` aria-current=currentPath.startsWith("/profile/") ? "page" : undefined)
              img.nav-icon(src="/resources/profile.svg" alt="")
              span Profile
          div.nav-btn.btn-inactive(class=currentPath === "/settings" ? "active" : "")
            a.sidebar-link(href="/settings" aria-current=currentPath === "/settings" ? "page" : undefined)
              img.nav-icon(src="/resources/settings.svg" alt="")
              span Settings
      main.main-content
        block post
          div.create-post
            div.post-form
              form(action="/post" method="POST")
                div.form-group
                  input.post-input(type="text", name="message" autocomplete="off" placeholder=`What's new, ${user.firstName}?`)
                div.tag-selector.hidden
                  button.tag-btn(type="button" data-tag="General") General
                  button.tag-btn(type="button" data-tag=user.major)= user.major
                div.image-preview.hidden
                  img.image-preview-image(alt="Selected image preview")
                  button.image-preview-remove(type="button" aria-label="Remove selected image") Remove image
                div.post-form-actions
                  input.image-file-input(type="file" accept="image/*" aria-label="Choose an image")
                  input.image-source-input(type="hidden" name="imageSource")
                  div.image-upload-row
                    button.image-upload-btn(type="button" aria-label="Add an image")
                      img(src="/resources/image.svg" alt="" aria-hidden="true")
                    span.image-upload-callout
                      strong ← New! 
                    p Share an image of your world.
                  input.btn.post-btn(type="submit" value="Post")
                p.upload-results(role="status" aria-live="polite")
        block posts
          if post_list
            div.posts-container
              each post in post_list
                //- - console.log(JSON.stringify(post))
                div.post(data-content-type=post.contentType data-post-id=post._id data-tags=post.tags.join(','))
                  div.post-header
                    //- - var safeColor = (post.user.colorPreference || '').replace(/[^a-zA-Z0-9\-_]/g, '')
                    div.post-icon(class=`gradient-${post.user.colorPreference}`)
                      a(href=`/profile/${post.user.username}`)
                        img(src=`/resources/icons/${post.user.icon}`, alt=`${post.user.username}'s profile picture`)
                    div.post-author
                      a.username(href=`/profile/${post.user.username}`) #{post.user.username}
                      span.major #{post.user.major}
                    span.timestamp #{post.timestamp_formatted}
                  div.post-content
                    p.post-message #{post.message}
                    if post.imageSource
                       img.post-image(
                      src=post.imageSource
                         alt="Post Image"
                         loading="lazy"
                         referrerpolicy="no-referrer"
                       )
                  div.post-actions
                    button.like-btn(
                      class=post.hasUserLiked(user._id) ? 'liked' : ''
                      data-post-id=post._id
                    )
                      span.like-icon
                        svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                          path(d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z")
                      span.like-count #{post.likeCount || 0}
                    button.comment-btn(data-post-id=post._id)
                      span.comment-icon 
                        svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                          path(d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z")
                      span.comment-count #{post.commentCount || 0}  
      aside.right-sidebar
        div.sidebar-tags
          span.sidebar-header Trending
          .tag-filters 
            button.tag-filter-btn(data-tag="#dawgpack") #dawgpack
        div.sidebar-tags
          span.sidebar-header Suggested Topics
          div.tag-filters
            button.tag-filter-btn.active(data-tag="all") All Posts
            button.tag-filter-btn(data-tag="ai") AI
            button.tag-filter-btn(data-tag="huskyfootball") Husky Football
            button.tag-filter-btn(data-tag=user.major)= user.major
        div.sidebar-tags
          span.sidebar-header Suggested Courses
          div.tag-filters
            button.tag-filter-btn.active(data-tag="all") All Courses
            button.tag-filter-btn(data-tag="CSE 391") CSE 391
            button.tag-filter-btn(data-tag="CSE 351") CSE 351
            button.tag-filter-btn(data-tag="CSE 331") CSE 331
            button.tag-filter-btn(data-tag="browse") Browse more courses
  else
    block landing-page
      div.landing-page
        block logo 
          div.logo-container
            img(src="/resources/ivy.png" width="200")
            h1.logo Link
            h2.logo-subtext Connect with your college community.
        block login
          div.login-container
            div.login-form
              form(action="/login" method="POST")
                input.login-input(type="text", name="username" placeholder="Username or email")
                br
                input.login-input(type="password", name="password" placeholder="Password")
                br
                input.btn.login-btn(type="submit" value="Log In")
                br 

            div.login-bottom
              a(href="/forgot-password") Forgot password?
              p or
              a(href="/guest") Sign in as guest

            div.login-divider 

            div.login_new-account
              div.btn.login_new-account-btn
                a(href="/create-account") Create new account 